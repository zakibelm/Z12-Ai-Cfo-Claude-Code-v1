# ============================================================
# Z12 AI CFO — .env.example
# Copier vers .env et remplir toutes les valeurs obligatoires
# NE JAMAIS committer .env dans Git
# ============================================================

# ── Identité de l'instance ────────────────────────────────
COMPANY_NAME=Cabinet Comptable XYZ
PUBLIC_URL=https://votre-domaine.com

# ── Administrateur ────────────────────────────────────────
ADMIN_EMAIL=admin@votre-cabinet.com
ADMIN_PASSWORD=ChangerCeMotDePasse2024!

# ── Secrets cryptographiques ──────────────────────────────
# Générer avec : openssl rand -hex 32
JWT_SECRET=REMPLACER_PAR_openssl_rand_hex_32
SECRET_KEY=REMPLACER_PAR_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Base de données PostgreSQL ────────────────────────────
POSTGRES_USER=ai_cfo
POSTGRES_PASSWORD=REMPLACER_PAR_openssl_rand_hex_16
POSTGRES_DB=ai_cfo_db
DATABASE_URL=postgresql://ai_cfo:POSTGRES_PASSWORD@db:5432/ai_cfo_db

# ── Intelligence artificielle ─────────────────────────────
# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-REMPLACER_PAR_VOTRE_CLE
DEFAULT_MODEL=anthropic/claude-3-haiku
BANK_RECONCILIATION_MODEL=anthropic/claude-3-opus
BANK_RECONCILIATION_TEMPERATURE=0

# ── CORS et origines autorisées ───────────────────────────
ALLOWED_ORIGINS=https://votre-domaine.com,http://localhost:3000

# ── WhatsApp (optionnel) ──────────────────────────────────
WHATSAPP_MODE=twilio_api
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=REMPLACER_PAR_TOKEN_TWILIO
TWILIO_FROM=whatsapp:+14155238886
WHATSAPP_BRIDGE_URL=http://localhost:3001
WHATSAPP_WHITELIST=+1XXXXXXXXXX

# ── Email / Notifications (optionnel) ─────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@votre-cabinet.com
SMTP_PASSWORD=REMPLACER_PAR_MOT_DE_PASSE_APP
SMTP_FROM=Z12 AI CFO <notifications@votre-cabinet.com>

# ── OAuth (optionnel) ─────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── Monitoring (optionnel) ────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=INFO

# ── Backup automatique ────────────────────────────────────
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_DIR=/var/backups/z12-cfo

# ── Conformite Loi 25 (Quebec) ───────────────────────────
INSTANCE_ID=z12-cfo-REMPLACER_PAR_NOM_CLIENT
PRIVACY_OFFICER_EMAIL=responsable@votre-cabinet.com

# ── Environnement ─────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false

# ============================================================
# CHECKLIST AVANT DEMARRAGE
# ============================================================
# [ ] JWT_SECRET et SECRET_KEY : openssl rand -hex 32 (32 caracteres minimum, sinon le backend refuse de demarrer)
# [ ] POSTGRES_PASSWORD : openssl rand -hex 16
# [ ] OPENROUTER_API_KEY remplie et testee
# [ ] PUBLIC_URL et ALLOWED_ORIGINS = vrai domaine/IP
# [ ] ADMIN_EMAIL et ADMIN_PASSWORD personnalises
# [ ] .env dans .gitignore (ne jamais committer)
# [ ] INSTANCE_ID unique par client (Loi 25)
# ============================================================

# Secret interne pour WhatsApp (generer avec openssl rand -hex 32)
INTERNAL_SERVICE_SECRET=REMPLACER_openssl_rand_hex_32

# ── Securite (audit 2026-11) ──────────────────────────────
# AUTH_MODE=strict est le defaut. "dev" desactive l'authentification : jamais en production.
AUTH_MODE=strict
# URL publique exacte du webhook WhatsApp (celle configuree chez Twilio), pour valider la signature
WHATSAPP_WEBHOOK_URL=https://votre-domaine.com/api/whatsapp/webhook
# Prefixes de modeles autorises sur /api/chat (vide = tous). Recommande en production.
CHAT_ALLOWED_MODEL_PREFIXES=anthropic/,google/,deepseek/,qwen/,meta-llama/,mistralai/
# Plafonds (valeurs par defaut indiquees)
MAX_TOKENS_CAP=4000
LLM_RATE_PER_MINUTE=30
UPLOAD_RATE_PER_MINUTE=20
AUTH_RATE_PER_MINUTE=10
MAX_FILE_SIZE_MB=25
MAX_FILES_PER_REQUEST=10
MAX_REQUEST_MB=100
RUN_BUDGET_CAP=25

# Administrateurs de la plateforme (identifiants de compte, separes par des virgules).
# Seuls ces comptes voient, enrichissent et modifient le RAG metier (sources de connaissance),
# qui sert ensuite aux agents de tous les utilisateurs. Vide = aucun administrateur et
# aucune source metier servie.
ADMIN_USER_IDS=

# Description des images par un modele de vision (OpenRouter). S'applique uniquement aux
# sources metier non confidentielles : les images des dossiers client restent sur le serveur.
# Vide = desactive (les images restent indexees par leur texte, lu en local par OCR).
# Le modele doit accepter les images en entree (input_modalities contient "image").
IMAGE_DESCRIPTION_MODEL=
IMAGE_DESCRIPTION_MAX_PER_DOC=20

# Inscription : invite (defaut) = code d'invitation a usage unique, cree par un administrateur ;
# open = inscription libre ; closed = aucune inscription.
REGISTRATION_MODE=invite

# Budget de consommation, compte au cout reel renvoye par le fournisseur (tous modeles).
# TRIAL_BUDGET_CAD : budget d'essai TOTAL par compte (non renouvele) ; modifiable compte par
#   compte dans Parametres > Budgets. Valeur negative = pas de limite par compte.
# PLATFORM_MONTHLY_BUDGET_CAD : plafond mensuel pour toute la plateforme, administrateur compris.
# USD_TO_CAD : taux applique aux couts factures en dollars americains.
TRIAL_BUDGET_CAD=3
PLATFORM_MONTHLY_BUDGET_CAD=150
USD_TO_CAD=1.40

# Modele de repli quand le fournisseur retire un modele (reponse 404). Doit exister au catalogue.
FALLBACK_MODEL=deepseek/deepseek-v4-pro

# Depot de documents dans le RAG. Le fichier est ecrit sur disque par blocs puis indexe en
# arriere-plan (statut "processing", puis "indexed" ou "error").
# MAX_KNOWLEDGE_FILE_MB : taille maximale d'un document. Le serveur web doit l'autoriser aussi
#   (nginx : client_max_body_size). MAX_FILE_SIZE_MB ne concerne que les pieces jointes du chat.
# INGEST_CONCURRENCY : indexations simultanees. Un document est charge en memoire pendant sa
#   conversion : garder 1 sauf memoire abondante.
# INGEST_BACKGROUND=0 : indexer dans la requete d'envoi (tests, petits documents seulement).
MAX_KNOWLEDGE_FILE_MB=500
MAX_KNOWLEDGE_REQUEST_MB=1024
INGEST_CONCURRENCY=1
# Documents numerises : nombre de pages lues par OCR et duree maximale de l'OCR d'un document.
# Au-dela, les pages restantes ne sont pas lues et un avertissement est affiche.
MAX_PDF_PAGES_OCR=40
OCR_TIMEOUT_SECONDS=300

# PDF : jusqu'a MAX_PDF_PAGES pages, chaque page est convertie en Markdown (tableaux conserves).
# Au-dela (manuels, recueils), le texte est lu par pdftotext en une passe, page par page.
MAX_PDF_PAGES=500
# Images d'un document : delai par tranche de pages, budget total, taille d'une tranche.
IMAGE_EXTRACT_TIMEOUT_SECONDS=60
IMAGE_EXTRACT_BUDGET_SECONDS=300
IMAGE_PAGE_WINDOW=25

# Longueur maximale d'une reponse (reflexion du modele comprise) et delai accorde au fournisseur.
# L'interface demande 12 000 jetons pour un specialiste, 8 000 pour une synthese, 1 500 pour le plan.
MAX_TOKENS_CAP=16000
PROVIDER_TIMEOUT_SECONDS=240
